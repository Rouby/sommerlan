directive @rbac on OBJECT

type AddGameResult {
  attending: Attending!
  game: Game!
}

type Attending {
  applicationDate: Date!
  checkIn: DateTime
  checkOut: DateTime
  dates: [Date!]!
  gamesPlayed: [Game!]!
  id: ID!
  notificationSent: DateTime
  paidDues: Float!
  party: Party!
  rentDues: Float
  room: RoomStatus
  seatNumber: String
  user: User!
  withPc: Boolean
}

type AuthDevice {
  createdAt: DateTime
  id: ID!
  lastUsedAt: DateTime
  name: String!
}

type AuthResponse {
  refreshToken: String!
  token: JWT!
}

type BeerPongGroup {
  matches: [BeerPongMatch!]!
  name: String!
  teams: [BeerPongGroupStanding!]!
}

type BeerPongGroupStanding {
  losses: Int!
  matches: Int!
  rank: Int!
  remainingBeerDiff: Int!
  remainingBeers: Int!
  team: BeerPongTeam!
  wins: Int!
}

type BeerPongKnockoutRound {
  matches: [BeerPongMatch!]!
  name: String!
  round: Int!
}

type BeerPongMatch {
  endedAt: DateTime
  groupName: String
  id: ID!
  matchNumber: Int!
  phase: BeerPongMatchPhase!
  players: [BeerPongPlayerStats!]!
  round: Int!
  startedAt: DateTime!
  teams: [BeerPongMatchTeam!]!
  winner: BeerPongTeam
}

enum BeerPongMatchPhase {
  EXHIBITION
  GROUP
  KNOCKOUT
}

type BeerPongMatchTeam {
  isWinner: Boolean!
  remainingBeers: Int!
  slotLabel: String!
  team: BeerPongTeam
}

input BeerPongMatchTeamResultInput {
  remainingBeers: Int!
  teamId: ID!
}

type BeerPongPlayerStats {
  blocks: Int!
  bounceHits: Int!
  edges: Int!
  hits: Int!
  throws: Int!
  user: User!
}

input BeerPongPlayerStatsInput {
  blocks: Int!
  bounceHits: Int!
  edges: Int!
  hits: Int!
  throws: Int!
  userId: ID!
}

type BeerPongTeam {
  id: ID!
  name: String!
  players: [User!]!
  seed: Int!
}

input BeerPongTeamInput {
  id: ID
  name: String!
  playerIds: [ID!]!
}

type BeerPongTournament {
  groupCount: Int!
  groups: [BeerPongGroup!]!
  id: ID!
  knockout: [BeerPongKnockoutRound!]!
  knockoutSize: Int!
  matches: [BeerPongMatch!]!
  name: String!
  teams: [BeerPongTeam!]!
}

scalar BoundingBox

type CacheEntry {
  patches: [CachePatch!]!
  sheet: String!
}

type CacheInfo {
  entries: [CacheEntry!]!
  lastSync: DateTime
}

type CachePatch {
  id: ID!
  operations: JSON!
}

input CreateMoneyTransferInput {
  amount: Float!
  note: String!
  valuationDate: Date!
}

scalar Date

scalar DateTime

type Donation {
  amount: Float!
  dedication: DonationDedication!
  donator: User
  id: ID!
  party: Party!
  received: Boolean!
}

enum DonationDedication {
  RENT
  WARCHEST
}

type Event {
  date: Date
  description: String
  endTime: String
  id: ID!
  image: String!
  name: String!
  organizer: User!
  participants: [User!]!
  party: Party!
  startTime: String
}

input EventInput {
  date: Date
  description: String
  endTime: String
  id: ID
  image: File
  name: String!
  partyId: ID!
  startTime: String
}

scalar File

type Game {
  id: ID!
  image: String!
  name: String!
  players: [User!]!
}

input GameInput {
  id: ID!
  image: File!
}

type GameOnParty {
  game: Game!
  id: ID!
  party: Party!
  players: [User!]!
}

scalar JSON

scalar JWT

type Location {
  latitude: Float!
  longitude: Float!
  timestamp: DateTime!
}

type LoginResponse {
  credentialID: [Int!]!
  refreshToken: String!
  token: JWT!
}

type MoneyTransfer {
  amount: Float!
  correlationId: ID
  id: ID!
  note: String
  valuationDate: Date!
}

type Mutation {
  addGameToParty(name: String!, partyId: ID!): AddGameResult!
  addPicture(input: PictureInput!): Picture!
  capturePayPalOrder(orderId: ID!): Attending
  checkIn(userId: ID!): Attending
  checkOut(userId: ID!): Attending
  createBeerPongMatch(playerIds: [ID!]!): BeerPongMatch!
  createMoneyTransfer(input: CreateMoneyTransferInput!): MoneyTransfer!
  createPayPalOrder: ID!
  createPurchase(
    description: String!
    estimatedCost: Float!
    title: String!
  ): Purchase!
  deleteAuthDevice(id: ID!): AuthDevice!
  deleteBeerPongMatch(matchId: ID!): Boolean!
  denyRoom(attendingId: ID!): Attending
  donate(
    amount: Float!
    dedication: DonationDedication
    incognito: Boolean
  ): Donation!
  endBeerPongMatch(matchId: ID!, winnerTeamId: ID!): BeerPongMatch!
  generateBeerPongGroupStage(tournamentId: ID!): BeerPongTournament!
  generateBeerPongKnockoutStage(tournamentId: ID!): BeerPongTournament!
  generatePasskeyLoginOptions(userId: String): JSON!
  generatePasskeyRegisterOptions(userId: String!): JSON!
  grantRoom(attendingId: ID!): Attending
  leaveEvent(id: ID!, userId: ID): Event!
  loginMagicLink(magicLinkId: String!): AuthResponse!
  loginPasskey(response: JSON!): LoginResponse!
  loginPassword(email: String!, password: String!): AuthResponse!
  participateInEvent(id: ID!, userId: ID): Event!
  planEvent(input: EventInput!): Event!
  recindRoom(partyId: ID!): Attending
  refreshLogin(refreshToken: String!): AuthResponse!
  register(
    email: String!
    password: String
    userName: String!
  ): RegisterResponse!
  registerPasskey(
    name: String!
    response: JSON!
    userId: String!
  ): RegisterDeviceResponse!
  removeAttendance(partyId: ID!, userId: ID): Party!
  removeProfilePicture: User!
  requestRoom(partyId: ID!): Attending
  rescindDonation(id: ID!): Donation!
  sendMagicLink(email: String!): Boolean!
  sendPaymentNotification(userId: ID!): Attending!
  sendPaymentNotificationToAll: [Attending!]!
  setAttendance(dates: [Date!]!, partyId: ID!, userId: ID): Party!
  setGamesPlayed(gameIds: [ID!]!, partyId: ID!): Attending!
  syncCache(clear: Boolean): Boolean
  updateAttending(input: UpdateAttendingInput!, partyId: ID!): Attending!
  updateAuthDevice(id: ID!, name: String!): AuthDevice!
  updateBeerPongMatch(input: UpdateBeerPongMatchInput!): BeerPongMatch!
  updateBeerPongPlayerStats(
    input: BeerPongPlayerStatsInput!
    matchId: ID!
  ): BeerPongMatch!
  updateGame(input: GameInput!): Game!
  updateLocation(latitude: Float!, longitude: Float!): User!
  updatePaidDues(attendingId: ID!, paidDues: Float!): Attending
  updateParty(input: PartyInput!): Party!
  updateProfile(input: ProfileInput!): User!
  updatePurchaseStatus(purchaseId: ID!, status: PurchaseStatus!): Purchase!
  updateRoles(id: ID!, roles: [Role!]!): User!
  upsertBeerPongTournament(
    input: UpsertBeerPongTournamentInput!
  ): BeerPongTournament!
  voteOnPurchase(purchaseId: ID!, vote: VoteValue!): Purchase!
}

type Party {
  attending(userId: ID): Attending
  attendings: [Attending!]!
  costPerDay: Float!
  donations: [Donation!]!
  endDate: Date!
  events: [Event!]!
  feedingCosts: Float!
  gamesPlayed: [GameOnParty!]!
  id: ID!
  latitude: Float!
  location: String!
  locationWidgetSrc: String
  longitude: Float!
  paidDues: Float
  payday: Date
  pictures: [Picture!]!
  registrationDeadline: Date
  rentalCosts: Float!
  roomsAvailable: Int!
  seatPlan: SeatPlan!
  seatsAvailable: Int!
  startDate: Date!
  tentative: Boolean!
}

input PartyInput {
  endDate: Date!
  feedingCosts: Float
  id: ID
  location: String!
  locationWidgetSrc: String
  payday: Date
  registrationDeadline: Date
  rentalCosts: Float
  roomsAvailable: Int!
  startDate: Date!
  tentative: Boolean
}

type Picture {
  id: ID!
  meta: PictureMeta!
  party: Party!
  tags: [PictureTag!]!
  url: String!
}

input PictureInput {
  file: File!
  name: String!
  partyId: ID!
  tags: [PictureTagInput!]
}

type PictureMeta {
  altitude: Float
  height: Int!
  latitude: Float
  longitude: Float
  takeAt: DateTime
  width: Int!
}

type PictureTag {
  boundingBox: BoundingBox!
  id: ID!
  picture: Picture!
  user: User!
}

input PictureTagInput {
  boundingBox: BoundingBox!
  userId: ID!
}

input ProfileInput {
  avatar: File
  displayName: String!
  email: String!
  id: ID
  name: String!
  password: String
}

type Purchase {
  createdAt: String!
  description: String!
  estimatedCost: Float!
  id: ID!
  proposer: User!
  status: PurchaseStatus!
  title: String!
  userVote: PurchaseVote
  voteCount: VoteCount!
  votes: [PurchaseVote!]!
}

enum PurchaseStatus {
  APPROVED
  COMPLETED
  PROPOSED
  REJECTED
}

type PurchaseVote {
  createdAt: String!
  user: User!
  vote: VoteValue!
}

type Query {
  beerPongMatches: [BeerPongMatch!]!
  beerPongTournament: BeerPongTournament
  games: [Game!]!
  getCacheInfo: CacheInfo
  me: User
  moneyTransfers: [MoneyTransfer!]!
  nextParty: Party
  parties: [Party!]!
  party(id: ID!): Party
  purchase(id: ID!): Purchase
  purchases: [Purchase!]!
  users: [User!]!
}

type RegisterDeviceResponse {
  device: AuthDevice!
  token: String!
}

type RegisterResponse {
  refreshToken: String!
  token: String!
  user: User!
}

enum Role {
  Admin
  Bookkeeper
  Doorkeeper
  Trusted
}

enum RoomStatus {
  GRANTED
  REQUESTED
}

type SeatPlan {
  elements: [SeatPlanElement!]!
  height: Float!
  width: Float!
}

type SeatPlanElement {
  height: Float!
  id: ID!
  label: String
  type: SeatPlanElementType!
  width: Float!
  x: Float!
  y: Float!
}

enum SeatPlanElementType {
  COLUMN
  COUCH
  DOOR
  ENTRANCE
  EXIT
  FRIDGE
  TABLE
  WC
}

scalar Time

input UpdateAttendingInput {
  seatNumber: String
  withPc: Boolean
}

input UpdateBeerPongMatchInput {
  isFinished: Boolean
  matchId: ID!
  playerStats: [BeerPongPlayerStatsInput!]
  startedAt: DateTime
  teamResults: [BeerPongMatchTeamResultInput!]
  winnerTeamId: ID
}

input UpsertBeerPongTournamentInput {
  groupCount: Int!
  id: ID
  knockoutSize: Int!
  name: String!
  teams: [BeerPongTeamInput!]!
}

type User {
  avatar: String!
  avatarUrl: String
  devices: [AuthDevice!]!
  displayName: String!
  email: String!
  id: ID!
  lastKnownLocation: Location
  locations: [Location!]!
  name: String!
  roles: [Role!]!
}

type VoteCount {
  abstain: Int!
  no: Int!
  yes: Int!
}

enum VoteValue {
  ABSTAIN
  NO
  YES
}
